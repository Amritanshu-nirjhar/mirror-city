{
  "name": "mirror-city",
  "private": true,
  "type": "module",
  "scripts": {
    "cesium": "node -e \"require('fs').cpSync('node_modules/cesium/Build/Cesium','public/cesium',{recursive:true})\"",
    "dev": "npm run cesium && vite",
    "build": "npm run cesium && tsc --noEmit && vite build"
  },
  "dependencies": {
    "cesium": "^1.147.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  }
}
