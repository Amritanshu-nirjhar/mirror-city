# Copy to .env. Docker Compose and the Python code both read these.

POSTGRES_USER=mirror
POSTGRES_PASSWORD=mirror
POSTGRES_DB=mirror_city
DB_PORT=5432
# Used when running the API (cd api && uvicorn app.main:app) or ingestion outside Docker.
DATABASE_URL=postgresql://mirror:mirror@localhost:5432/mirror_city

# PLATEAU dataset. The PRD names the 2024 Sumida dataset, but the PLATEAU catalogue
# only publishes 2025 for municipality 13107 (checked 2026-11-10). Ingestion fails
# loudly if the year set here is not in the catalogue; it never substitutes another year.
PLATEAU_CITY_CODE=13107
PLATEAU_YEAR=2025

# Pilot area of interest (lon/lat, JGD2011). Widen these to expand coverage.
AOI_WEST=139.80
AOI_SOUTH=35.70
AOI_EAST=139.83
AOI_NORTH=35.73
